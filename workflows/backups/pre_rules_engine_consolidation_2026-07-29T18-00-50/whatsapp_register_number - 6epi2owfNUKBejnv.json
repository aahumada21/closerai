    {
      "parameters": {
        "jsCode": "const input = $json.body || $json;\nconst phoneNumberId = String(input.phone_number_id || '').trim();\nconst pin = String(input.pin || $env.DEFAULT_PIN || '').trim();\nconst graphVersion = String($env.META_GRAPH_VERSION || 'v20.0').trim();\nif (!phoneNumberId) throw new Error('phone_number_id is required');\nif (!pin) throw new Error('pin is required');\nif (!$env.META_ACCESS_TOKEN) throw new Error('META_ACCESS_TOKEN is required');\nreturn [{ json: {\n  phone_number_id: phoneNumberId,\n  pin,\n  graph_version: graphVersion,\n  graph_url: 'https://graph.facebook.com/' + graphVersion + '/' + encodeURIComponent(phoneNumberId) + '/register',\n  requested_at: new Date().toISOString()\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -464,
        48
      ],
      "id": "code-prepare-register-request",
      "name": "CODE prepare_register_request"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.graph_url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ \"Bearer \" + $env.META_ACCESS_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { messaging_product: \"whatsapp\", pin: $json.pin } }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -176,
        48
      ],
      "id": "http-register-phone-number",
      "name": "HTTP register_phone_number"
    },
    {
      "parameters": {
        "jsCode": "const raw = $json;\nconst error = raw.error || raw.body?.error || raw.response?.error;\nif (error) {\n  return [{ json: {\n    success: false,\n    error_code: String(error.code || error.type || 'meta_register_error'),\n    error_message: String(error.message || 'register failed'),\n    raw\n  } }];\n}\nreturn [{ json: {\n  success: true,\n  phone_number_id: $('CODE prepare_register_request').first().json.phone_number_id,\n  registered_at: new Date().toISOString(),\n  raw\n} }];"
      },
