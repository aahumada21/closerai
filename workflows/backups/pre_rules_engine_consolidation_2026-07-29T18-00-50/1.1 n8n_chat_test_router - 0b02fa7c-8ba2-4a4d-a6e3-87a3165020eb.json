        }
      }
    },
    {
      "parameters": {
        "jsCode": "const row = $json;\n\nconst message =\n  row.content ||\n  row.message ||\n  row.output ||\n  null;\n\nif (!message) {\n  return [\n    {\n      json: {\n        output: \"No encontr una respuesta generada por el bot. Revisa si el action_executor lleg a enviar/guardar el mensaje outbound.\"\n      }\n    }\n  ];\n}\n\nreturn [\n  {\n    json: {\n      output: message\n    }\n  }\n];"
      },
