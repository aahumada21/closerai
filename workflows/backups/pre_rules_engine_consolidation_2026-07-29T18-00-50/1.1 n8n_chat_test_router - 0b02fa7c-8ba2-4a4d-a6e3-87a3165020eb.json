          "name": "Postgres account 2"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT *\nFROM public.test_chat_sessions\nWHERE chat_session_id = '{{ $json.chat_session_id.replace(/'/g, \"''\") }}'\nLIMIT 1;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        448,
        64
      ],
      "id": "d151ccb3-f6d7-44d5-adb7-cb59045a8496",
      "name": "db BuscarNumero",
      "credentials": {
        "postgres": {
          "id": "a9C9SXdbhsOBvUzF",
          "name": "Postgres account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const chatInput = $('parse_chat_input').first().json;\nconst session = $json;\n\nconst phone = String(session.assigned_phone || '').replace(/\\D/g, '');\n\nif (!phone || !phone.startsWith('56')) {\n  throw new Error('Invalid assigned_phone for n8n_chat test session');\n}\n\nconst now = new Date().toISOString();\n\nreturn [\n  {\n    json: {\n      channel: 'n8n_chat',\n      lead_id: phone,\n      phone,\n      message_id: `n8n_chat_${chatInput.chat_session_id}_${Date.now()}`,\n      timestamp: now,\n      message_type: 'text',\n      text: chatInput.text,\n      attachments: [],\n      contact: {\n        wa_id: phone,\n        name: session.assigned_name || `Test Chat ${phone}`\n      },\n      source_metadata: {\n        provider: 'n8n_chat',\n        chat_session_id: chatInput.chat_session_id,\n        assigned_phone: phone,\n        test_mode: true\n      },\n      raw_message: {\n        chat_session_id: chatInput.chat_session_id,\n        text: chatInput.text\n      }\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        864,
        64
      ],
      "id": "e0e7a677-934e-4738-ba28-ba54558c152b",
      "name": "build_normalized_event"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT agent_id, organization_id\nFROM public.agent_channels\nWHERE provider = 'n8n_chat_test'\n  AND external_channel_id = '{{ $json.phone.replace(/'/g, \"''\") }}'\n  AND is_active = true\nLIMIT 1;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        928,
        64
      ],
      "id": "aeb0a767-c1d9-476f-8623-c8aef350470b",
      "name": "lookup_test_agent_channel",
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "a9C9SXdbhsOBvUzF",
          "name": "Postgres account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const event = $('build_normalized_event').first().json;\nconst match = $json || {};\n\n// Ya no hay fallback a un agente por defecto: si el numero de prueba no esta\n// registrado en agent_channels, se marca agent_resolved=false y se corta antes\n// de entrar al pipeline real (mismo criterio que channel_config_resolver usa\n// para WhatsApp/webchat -- nunca inventar un agente).\nconst agentId = match.agent_id || null;\nconst organizationId = match.organization_id || null;\n\nreturn [\n  {\n    json: {\n      ...event,\n      agent_id: agentId,\n      organization_id: organizationId,\n      agent_resolved: !!(agentId && organizationId),\n      routing: {\n        ...(event.routing || {}),\n        agent_id: agentId,\n        organization_id: organizationId\n      }\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1104,
        64
      ],
      "id": "90cee33e-d624-46b9-8e3f-c05bad348267",
