{
  "updatedAt": "2026-07-23T22:33:54.034Z",
  "createdAt": "2026-07-04T18:00:20.655Z",
  "id": "tL57zrWhC3irrlTB",
  "name": "QA Summary Every 5 Min",
  "description": null,
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "id": "sched1",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "qry1",
      "name": "Query QA last 5 min",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        480,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "a9C9SXdbhsOBvUzF",
          "name": "Postgres account 2"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT count(*)::int AS total_completados, count(*) FILTER (WHERE llm_passed = true)::int AS total_pasados, count(*) FILTER (WHERE llm_passed = false AND llm_notes NOT LIKE '%No se pudo%')::int AS total_fallidos FROM qa_test_results WHERE created_at > NOW() - INTERVAL '5 minutes' AND llm_passed IS NOT NULL;",
        "options": {}
      }
    },
    {
      "id": "if1",
      "name": "IF hay resultados",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ Number($json.total_completados) }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true
      }
    },
    {
      "id": "code1",
      "name": "Build WA message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        240
      ],
      "parameters": {
        "jsCode": "const total=Number($json.total_completados||0);const pasados=Number($json.total_pasados||0);const fallidos=Number($json.total_fallidos||0);const pct=total>0?Math.round((pasados/total)*100):0;const hora=new Date().toISOString().substring(11,16);const msg=`QA Resumen (${hora} UTC):\\n- Completados: ${total}\\n- Pasados: ${pasados} (${pct}%)\\n- Fallidos: ${fallidos}`;return [{chatId:'1734857807',message:msg}];"
      }
    },
    {
      "id": "wa1",
      "name": "WB Send Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1200,
        240
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot8977117395:AAEOezIQYMbWRRF62th2v5C9vhaybcoDhUU/sendMessage",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "chat_id",
              "value": "={{ $json.chatId }}"
            },
            {
              "name": "text",
              "value": "={{ $json.message }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    }
  ],
  "connections": {
    "Every 5 Minutes": {
      "main": [
        [
          {
            "node": "Query QA last 5 min",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query QA last 5 min": {
      "main": [
        [
          {
            "node": "IF hay resultados",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF hay resultados": {
      "main": [
        [
          {
            "node": "Build WA message",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Build WA message": {
      "main": [
        [
          {
            "node": "WB Send Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
