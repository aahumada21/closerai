      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        -220
      ],
      "name": "refresh_access_token",
      "id": "gct-http-refresh"
    },
    {
      "parameters": {
        "jsCode": "const agentId = $(\"validate_token_input\").first().json.agent_id;\nconst tokens = $json || {};\n\nfunction sqlText(value) {\n  if (value === undefined || value === null || value === \"\") return \"NULL\";\n  return \"'\" + String(value).replace(/'/g, \"''\") + \"'\";\n}\n\nfunction sqlUuid(value) {\n  const text = String(value || \"\").trim();\n  const isUuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(text);\n  if (!isUuid) throw new Error(\"Invalid agent_id uuid: \" + text);\n  return \"'\" + text + \"'::uuid\";\n}\n\nconst expiresAt = new Date(Date.now() + (Number(tokens.expires_in || 3600) * 1000)).toISOString();\n\nconst query = `\nUPDATE public.google_calendar_connections\nSET access_token = ${sqlText(tokens.access_token)},\n    access_token_expires_at = ${sqlText(expiresAt)}::timestamptz,\n    updated_at = now()\nWHERE agent_id = ${sqlUuid(agentId)}\nRETURNING agent_id, google_email, access_token;\n`;\n\nreturn [{ json: { update_query: query, new_access_token: tokens.access_token } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        -220
      ],
      "name": "build_token_update_query",
      "id": "gct-build-update-query"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ $json.update_query }}",
        "options": {
          "connectionTimeout": 30,
          "queryBatching": "single"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1760,
        -220
      ],
      "name": "DB update_access_token",
      "id": "gct-db-update",
      "credentials": {
        "postgres": {
          "id": "a9C9SXdbhsOBvUzF",
          "name": "Postgres account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const built = $(\"build_token_update_query\").first().json;\nconst dbResult = $json || {};\nconst auth = $(\"decide_refresh_needed\").first().json;\n\nreturn [{\n  json: {\n    connected: true,\n    access_token: dbResult.access_token || built.new_access_token,\n    google_email: dbResult.google_email || null,\n    calendar_id: auth.calendar_id || null\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        -220
      ],
      "name": "finalize_refreshed",
      "id": "gct-finalize-refreshed"
