        "jsCode": "const input = $json || {};\n\nreturn [{\n  json: {\n    connected: true,\n    access_token: input.access_token,\n    google_email: input.google_email || null,\n    calendar_id: input.calendar_id || null\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        -20
      ],
      "name": "finalize_cached",
      "id": "gct-finalize-cached"
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    connected: false,\n    access_token: null,\n    google_email: null,\n    calendar_id: null\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
