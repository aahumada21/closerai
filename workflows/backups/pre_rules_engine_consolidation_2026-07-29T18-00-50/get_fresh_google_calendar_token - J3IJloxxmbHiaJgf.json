    {
      "parameters": {
        "inputSource": "jsonExample",
        "jsonExample": "{\n  \"agent_id\": \"\"\n}"
      },
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "name": "When Executed by Another Workflow",
      "id": "gct-trigger"
    },
    {
      "parameters": {
        "jsCode": "const input = $json || {};\nconst agentId = String(input.agent_id || \"\").trim();\n\nconst isUuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(agentId);\n\nif (!isUuid) {\n  // Sin agent_id valido no hay nada que buscar: no lanzamos error para no\n  // romper el flujo de booking de leads viejos sin agent_id asignado todavia\n  // (445 leads historicos no tienen agent_id). Simplemente no hay conexion.\n  return [{\n    json: {\n      agent_id: null,\n      lookup_query: \"SELECT false AS connected, NULL AS google_email, NULL AS refresh_token, NULL AS access_token, NULL::timestamptz AS access_token_expires_at, NULL AS calendar_id;\"\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    agent_id: agentId,\n    lookup_query: `\nSELECT\n  EXISTS(SELECT 1 FROM public.google_calendar_connections WHERE agent_id = '${agentId}'::uuid) AS connected,\n  (SELECT google_email FROM public.google_calendar_connections WHERE agent_id = '${agentId}'::uuid) AS google_email,\n  (SELECT refresh_token FROM public.google_calendar_connections WHERE agent_id = '${agentId}'::uuid) AS refresh_token,\n  (SELECT access_token FROM public.google_calendar_connections WHERE agent_id = '${agentId}'::uuid) AS access_token,\n  (SELECT access_token_expires_at FROM public.google_calendar_connections WHERE agent_id = '${agentId}'::uuid) AS access_token_expires_at,\n  (SELECT calendar_id FROM public.google_calendar_connections WHERE agent_id = '${agentId}'::uuid) AS calendar_id;\n`\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "name": "validate_token_input",
      "id": "gct-validate-input"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ $json.lookup_query }}",
        "options": {
          "connectionTimeout": 30,
          "queryBatching": "single"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        440,
        0
      ],
      "name": "DB lookup_connection",
      "id": "gct-db-lookup",
      "credentials": {
        "postgres": {
          "id": "a9C9SXdbhsOBvUzF",
          "name": "Postgres account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const input = $json || {};\n\nconst connected = input.connected === true || input.connected === \"t\" || input.connected === \"true\";\n\nif (!connected) {\n  return [{ json: { connected: false, needs_refresh: false } }];\n}\n\nconst expiresAt = input.access_token_expires_at ? new Date(input.access_token_expires_at).getTime() : 0;\nconst needsRefresh = !input.access_token || !expiresAt || expiresAt < (Date.now() + 60000);\n\nreturn [{\n  json: {\n    connected: true,\n    needs_refresh: needsRefresh,\n    refresh_token: input.refresh_token,\n    access_token: input.access_token,\n    google_email: input.google_email,\n    calendar_id: input.calendar_id\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
