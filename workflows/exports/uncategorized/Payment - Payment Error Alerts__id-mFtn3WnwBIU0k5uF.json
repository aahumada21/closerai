  "name": "Payment Error Alerts",
  "description": null,
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "id": "error_trigger_payment_alerts",
      "name": "Error Trigger"
    },
    {
      "parameters": {
        "jsCode": "const d = $json;\nconst workflowName = d.workflow?.name || d.workflowName || \"workflow desconocido\";\nconst errorMessage = d.execution?.error?.message || d.error?.message || d.errorMessage || \"error desconocido\";\nconst nodeName = d.execution?.lastNodeExecuted || d.execution?.error?.node?.name || \"\";\nconst executionUrl = d.execution?.url || d.executionUrl || \"\";\n\nconst lines = [\n  \"ALERTA: fallo de ejecucion en pagos\",\n  \"Workflow: \" + workflowName\n];\nif (nodeName) lines.push(\"Nodo: \" + nodeName);\nlines.push(\"Error: \" + errorMessage);\nif (executionUrl) lines.push(executionUrl);\n\nreturn [{ message: lines.join(\"\\n\") }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "id": "build_error_alert_message",
      "name": "build_error_alert_message"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://n8n.aahumada.com/webhook/qa-notify-whatsapp",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: $json.message }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "id": "send_error_alert_telegram",
      "name": "send_error_alert_telegram",
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
