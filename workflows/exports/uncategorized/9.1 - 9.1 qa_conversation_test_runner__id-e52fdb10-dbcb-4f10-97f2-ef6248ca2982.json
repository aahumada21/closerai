        "query": "SELECT\n  scenario_key AS id,\n  name,\n  suite,\n  priority,\n  tags,\n  steps,\n  expected_outcome\nFROM public.qa_test_scenarios\nWHERE enabled = true\n  AND (\n    '{{$json.scenario_key}}' = ''\n    OR scenario_key = '{{$json.scenario_key}}'\n  )\nORDER BY\n  priority ASC,\n  scenario_key ASC;",
        "options": {}
