      ],
      "parameters": {
        "jsCode": "const expiresAt = new Date(Date.now() + 3600 * 1000).toISOString();\nreturn [{ json: { access_token: $json.access_token, expires_at: expiresAt, agent_id: $('check_token_validity').first().json.agent_id }}];"
