        "operation": "executeQuery",
        "query": "SELECT google_access_token, google_refresh_token, google_token_expires_at FROM agents WHERE id = '{{ $json.agent_id }}'::uuid LIMIT 1;",
        "options": {}
      }
    },
    {
      "id": "code_check",
      "name": "check_token_validity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "jsCode": "const row = $input.first().json;\nconst expiresAt = row.google_token_expires_at ? new Date(row.google_token_expires_at) : null;\nconst now = new Date();\nconst fiveMin = 5 * 60 * 1000;\nconst needsRefresh = !expiresAt || !row.google_access_token || (expiresAt - now) < fiveMin;\nreturn [{ json: {\n  needs_refresh: needsRefresh,\n  access_token: row.google_access_token,\n  refresh_token: row.google_refresh_token,\n  agent_id: $('When Executed by Another Workflow').first().json.agent_id\n}}];"
      }
    },
